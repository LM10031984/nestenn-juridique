# ── LLM (OpenRouter) ─────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── DILA / PISTE (Légifrance + Judilibre) ─────────────────────────────
PISTE_CLIENT_ID=your-piste-client-id
PISTE_CLIENT_SECRET=your-piste-client-secret
PISTE_TOKEN_URL=https://oauth.piste.gouv.fr/api/oauth/token
PISTE_API_URL=https://api.piste.gouv.fr/dila/legifrance/lf-engine-app
# Mettre PISTE_ENV=sandbox pour utiliser l'environnement de test
PISTE_ENV=

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── Limites et configuration ──────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_SESSION=3
TOKEN_CACHE_DURATION_SECONDS=3600
CONVERSATION_RETENTION_DAYS=30

# ── Benchmark (dev seulement) ─────────────────────────────────────────
# BENCHMARK_API_URL=http://localhost:3000
