# =============================================================================
# NESTENN JURIDIQUE — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# JAMAIS committer .env.local dans git !
# =============================================================================

# --- OpenRouter (LLM) ---
# Clé API OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...

# --- PISTE/DILA API (Légifrance) ---
# Credentials OAuth2 obtenus sur https://piste.gouv.fr/registration
# Délai d'obtention : 24-72h (validation manuelle)
PISTE_CLIENT_ID=your_client_id
PISTE_CLIENT_SECRET=your_client_secret
PISTE_TOKEN_URL=https://oauth.piste.gouv.fr/api/oauth/token
PISTE_API_URL=https://api.piste.gouv.fr/dila/legifrance/lf-engine-app

# --- Supabase ---
# Obtenir sur https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # ATTENTION : ne jamais exposer côté client

# --- Limites (optionnel — valeurs par défaut indiquées) ---
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_SESSION=3
TOKEN_CACHE_DURATION_SECONDS=3600
CONVERSATION_RETENTION_DAYS=30
